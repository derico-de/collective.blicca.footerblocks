<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="collective.blicca.footerblocks">

  <i18n:registerTranslations directory="locales" />

  <include file="permissions.zcml" />

  <include package="plone.pageletlayout" file="meta.zcml" />
  <include package="plone.rest" file="meta.zcml" />

  <!-- The footer-blocks element: a chrome pagelet plus the wrapper viewlet
       that slots it into the whole-body layout manager; its position among
       the footer rows comes from profiles/default/viewlets.xml. -->
  <plone:chromepagelet
      name="collective.blicca.footerblocks.footerblocks"
      class=".pagelets.FooterBlocksChromePagelet"
      template="templates/footerblocks.pt"
      layer=".interfaces.ICollectiveBliccaFooterblocksLayer"
      />
  <browser:viewlet
      name="collective.blicca.footerblocks.footerblocks"
      pagelet="collective.blicca.footerblocks.footerblocks"
      class="plone.pageletlayout.pagelets.layout.PageletViewlet"
      manager="plone.pageletlayout.pagelets.layout.ILayoutManager"
      layer=".interfaces.ICollectiveBliccaFooterblocksLayer"
      permission="zope2.View"
      />

  <!-- The footer editing surface (auroraeditor ADR 0015): the edit page,
       the plone.rest save target the mount contract's contentUrl points
       at, and the browser-GET redirect at the same name (the host pattern
       navigates to contentUrl after save/cancel). All on the behavior's
       marker: the surface exists exactly where a footer can be stored. -->
  <browser:page
      name="edit-footer"
      for="collective.volto.footer.behaviors.footer.IEditableFooterMarker"
      class=".editing.FooterEditView"
      permission="cmf.ModifyPortalContent"
      layer=".interfaces.ICollectiveBliccaFooterblocksLayer"
      />
  <plone:service
      method="PATCH"
      name="@footerblocks"
      for="collective.volto.footer.behaviors.footer.IEditableFooterMarker"
      factory=".editing.FooterBlocksPatch"
      permission="cmf.ModifyPortalContent"
      layer=".interfaces.ICollectiveBliccaFooterblocksLayer"
      />
  <browser:page
      name="@footerblocks"
      for="collective.volto.footer.behaviors.footer.IEditableFooterMarker"
      class="plone.blicca.auroraeditor.editing.FieldSurfaceRedirect"
      permission="zope2.View"
      layer=".interfaces.ICollectiveBliccaFooterblocksLayer"
      />

  <!-- The Footer tab of the editor's edit-area strip (auroraeditor
       browser/tabs.py): the carrier is an ancestor of the page being
       edited, so the strip is where authors reach its footer. -->
  <subscriber
      for="* .interfaces.ICollectiveBliccaFooterblocksLayer"
      provides="plone.blicca.auroraeditor.interfaces.IEditSurfaceTab"
      factory=".tabs.FooterTab"
      />

  <!-- Same provider name as the base styles pagelet, this add-on's layer:
       every page's head gets the blocks stylesheets the footer needs
       (the layer extends IPlonePageletlayoutLayer, so this registration
       is unambiguously more specific). -->
  <plone:chromepagelet
      name="plone.pageletlayout.styles"
      class=".pagelets.FooterStylesChromePagelet"
      layer=".interfaces.ICollectiveBliccaFooterblocksLayer"
      />

  <genericsetup:registerProfile
      name="default"
      title="Collective Blicca Footerblocks"
      description="Blicca rendering of editable footer blocks (collective.volto.footer) in a pagelet chrome"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/default"
      />

  <genericsetup:registerProfile
      name="uninstall"
      title="Collective Blicca Footerblocks (uninstall)"
      description="Uninstalls collective.blicca.footerblocks"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/uninstall"
      />

  <genericsetup:importStep
      name="collective.blicca.footerblocks-uninstall"
      title="Collective Blicca Footerblocks uninstall"
      description="Uninstall collective.blicca.footerblocks"
      handler="collective.blicca.footerblocks.setuphandlers.uninstall"
      />

</configure>
