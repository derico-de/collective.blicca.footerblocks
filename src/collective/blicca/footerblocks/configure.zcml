<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    xmlns:plone="http://namespaces.plone.org/plone"
    xmlns:zcml="http://namespaces.zope.org/zcml"
    i18n_domain="collective.blicca.footerblocks">

  <i18n:registerTranslations directory="locales" />

  <include file="permissions.zcml" />

  <include package="plone.rest" file="meta.zcml" />

  <!-- The stock frame, always loaded: the footer blocks in Plone's own
       IPortalFooter (main_template renders it inside
       <footer id="portal-footer-wrapper">, full width) and the blocks
       stylesheets in IHtmlHead. Their positions come from
       profiles/default/viewlets.xml. -->
  <browser:viewlet
      name="collective.blicca.footerblocks.footerblocks"
      manager="plone.app.layout.viewlets.interfaces.IPortalFooter"
      class=".viewlets.FooterBlocksViewlet"
      template="templates/footerblocks.pt"
      layer=".interfaces.ICollectiveBliccaFooterblocksLayer"
      permission="zope2.View"
      />
  <browser:viewlet
      name="collective.blicca.footerblocks.styles"
      manager="plone.app.layout.viewlets.interfaces.IHtmlHead"
      class=".viewlets.FooterBlocksStylesViewlet"
      layer=".interfaces.ICollectiveBliccaFooterblocksLayer"
      permission="zope2.View"
      />

  <!-- The plone.pageletlayout frame, when that package is importable: the
       layout element under the same name (the bridge then skips the stock
       twin). The head styles override is overrides.zcml. -->
  <include file="pageletlayout.zcml" zcml:condition="installed plone.pageletlayout" />

  <!-- The footer editing surface (auroraeditor ADR 0015): the edit page,
       the plone.rest save target the mount contract's contentUrl points
       at, and the browser-GET redirect at the same name (the host pattern
       navigates to contentUrl after save/cancel). All on the behavior's
       marker: the surface exists exactly where a footer can be stored. -->
  <browser:page
      name="edit-footer"
      for="collective.volto.footer.behaviors.footer.IEditableFooterMarker"
      class=".editing.FooterEditView"
      permission="cmf.ModifyPortalContent"
      layer=".interfaces.ICollectiveBliccaFooterblocksLayer"
      />
  <plone:service
      method="PATCH"
      name="@footerblocks"
      for="collective.volto.footer.behaviors.footer.IEditableFooterMarker"
      factory=".editing.FooterBlocksPatch"
      permission="cmf.ModifyPortalContent"
      layer=".interfaces.ICollectiveBliccaFooterblocksLayer"
      />
  <browser:page
      name="@footerblocks"
      for="collective.volto.footer.behaviors.footer.IEditableFooterMarker"
      class="plone.blicca.auroraeditor.editing.FieldSurfaceRedirect"
      permission="zope2.View"
      layer=".interfaces.ICollectiveBliccaFooterblocksLayer"
      />

  <!-- The Footer tab of the editor's edit-area strip (auroraeditor
       browser/tabs.py): the carrier is an ancestor of the page being
       edited, so the strip is where authors reach its footer. -->
  <subscriber
      for="* .interfaces.ICollectiveBliccaFooterblocksLayer"
      provides="plone.blicca.auroraeditor.interfaces.IEditSurfaceTab"
      factory=".tabs.FooterTab"
      />

  <genericsetup:registerProfile
      name="default"
      title="Collective Blicca Footerblocks"
      description="Blicca rendering of editable footer blocks (collective.volto.footer) in a pagelet chrome"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/default"
      />

  <!-- Per-language footers, opt-in. The renderer and the Footer tab both
       stop at the *nearest* ancestor carrying the behavior (Volto's
       @inherit semantics), so marking the language root folders is what
       gives /de and /en a footer of their own — and what makes each of
       them responsible for having one. A multilingual site that wants a
       single shared footer simply does not apply this profile. -->
  <genericsetup:registerProfile
      name="multilingual"
      title="Collective Blicca Footerblocks: per-language footers"
      description="Lets each plone.app.multilingual language root folder carry its own footer. Requires plone.app.multilingual."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/multilingual"
      post_handler=".setuphandlers.post_multilingual_install"
      />

  <genericsetup:registerProfile
      name="uninstall"
      title="Collective Blicca Footerblocks (uninstall)"
      description="Uninstalls collective.blicca.footerblocks"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/uninstall"
      />

  <genericsetup:importStep
      name="collective.blicca.footerblocks-uninstall"
      title="Collective Blicca Footerblocks uninstall"
      description="Uninstall collective.blicca.footerblocks"
      handler="collective.blicca.footerblocks.setuphandlers.uninstall"
      />

  <!-- Keep the uninstall and upgrade profiles out of the Add-ons control panel.
       Without this registration the class in setuphandlers.py is inert and
       every one of those EXTENSION profiles is offered as an installable
       add-on of its own. -->
  <utility
      factory=".setuphandlers.HiddenProfiles"
      name="collective.blicca.footerblocks-hiddenprofiles"
      />


  <include package=".upgrades" />

</configure>
