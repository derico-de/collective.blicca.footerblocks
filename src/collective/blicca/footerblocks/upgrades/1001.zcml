<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="collective.blicca.footerblocks">

  <genericsetup:registerProfile
      name="1001"
      title="collective.blicca.footerblocks: upgrade to 1001"
      directory="1001"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

  <genericsetup:upgradeSteps
      source="1000"
      destination="1001"
      profile="collective.blicca.footerblocks:default">

    <genericsetup:upgradeStep
        title="Remove the footer edit object action"
        description="A custom upgrade step"
        handler=".v1001.upgrade"
        />

    <genericsetup:upgradeDepends
        title="Apply profile version 1001"
        import_profile="collective.blicca.footerblocks.upgrades:1001"
        />

  </genericsetup:upgradeSteps>

</configure>
