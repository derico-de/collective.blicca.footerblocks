<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="collective.blicca.footerblocks">

  <genericsetup:registerProfile
      name="1001"
      title="collective.blicca.footerblocks: upgrade to 1001"
      directory="1001"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

  <genericsetup:upgradeSteps
      source="1000"
      destination="1001"
      profile="collective.blicca.footerblocks:default">

    <genericsetup:upgradeStep
        title="Remove the footer edit object action"
        description="The Footer tab in the Aurora editor replaced it"
        handler=".v1001.upgrade"
        />

  </genericsetup:upgradeSteps>

</configure>
