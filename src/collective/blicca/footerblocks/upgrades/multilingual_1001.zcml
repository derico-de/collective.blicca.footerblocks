<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="collective.blicca.footerblocks">

  <!-- No upgrade profile directory here: profiles/multilingual/ is
       unchanged, what changed is what applying it does. Version 1000
       imported the type and stopped, leaving every unauthored language
       folder rendering no footer at all; 1001 seeds them as part of the
       import. This step is the same seeding, for a site that applied the
       profile while it was still at 1000. -->
  <genericsetup:upgradeSteps
      source="1000"
      destination="1001"
      profile="collective.blicca.footerblocks:multilingual">

    <genericsetup:upgradeStep
        title="Seed the per-language footers"
        description="Copy the inherited footer into every language root folder that has none of its own"
        handler=".multilingual_v1001.upgrade"
        />

  </genericsetup:upgradeSteps>

</configure>
