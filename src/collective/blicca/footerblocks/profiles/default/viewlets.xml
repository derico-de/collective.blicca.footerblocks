<?xml version="1.0" encoding="UTF-8"?>
<object>
  <!-- The footer-blocks viewlet joins IPortalFooter directly before
       plone.footer (the footer portlets), so the editable footer closes the
       page above the footer portlets, colophon and site actions — on stock
       Plone and in plone.pageletlayout's slot layout alike, which renders
       plone.portalfooter in footer#portal-footer-wrapper.

       insert-before, not a restated order: Plone owns the canonical
       sequence and this file must not fork it — the importer re-inserts
       the one name at the anchor, additively and idempotently. -->
  <order manager="plone.portalfooter" skinname="Plone Default">
    <viewlet name="collective.blicca.footerblocks.footerblocks"
             insert-before="plone.footer" />
  </order>
</object>
