<?xml version="1.0" encoding="UTF-8"?>
<object>
  <!-- The footer-blocks element joins the whole-body layout manager's order
       directly before the first plone.pageletlayout footer row, so the
       editable footer closes the page above copyright/colophon/siteactions.

       insert-before, not a restated order: plone.pageletlayout owns the
       canonical sequence and this file must not fork it — the importer
       re-inserts the one name at the anchor, additively and idempotently
       (the plonetheme.derico.contactband precedent). -->
  <order manager="plone.pageletlayout.layout" skinname="Plone Default">
    <viewlet name="collective.blicca.footerblocks.footerblocks"
             insert-before="plone.pageletlayout.copyright" />
  </order>
</object>
